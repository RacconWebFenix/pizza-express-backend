enum Role {
  CLIENTE
  ADMIN
  FUNCIONARIO
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Exemplo de modelo inicial para pizzas
model Pizza {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  preco       Float
  image       String?  // URL da imagem da pizza
  pedidos     Pedido[] @relation("PedidoPizzas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  password  String
  telefone  String?
  role      Role     @default(CLIENTE)
  enderecos Endereco[]
  pedidos   Pedido[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pedido {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  pizzas      Pizza[]  @relation("PedidoPizzas")
  status      String
  entregador  Entregador? @relation(fields: [entregadorId], references: [id])
  entregadorId Int?
  latitude    Float?
  longitude   Float?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Entregador {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String?
  pedidos   Pedido[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Endereco {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  cep         String
  tipo        String
  logradouro  String
  numero      String
  bairro      String
  complemento String?
  cidade      String
  estado      String
  pais        String?
  referencia  String?
  principal   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
