enum Role {
  CLIENTE
  USUARIO
  FUNCIONARIO
  ADMIN
}

// Enum para os status do pedido
enum StatusPedido {
  PENDENTE
  EM_PREPARO
  A_CAMINHO
  ENTREGUE
  CANCELADO
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Exemplo de modelo inicial para pizzas
model Pizza {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  preco       Float
  image       String? // URL da imagem da pizza
  pedidos     Pedido[] @relation("PedidoPizzas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  password  String
  telefone  String?
  avatar    String? // URL da foto do perfil do Google
  role      Role     @default(CLIENTE)
  enderecos Endereco[]
  pedidos   Pedido[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pedido {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  enderecoId     Int
  endereco       Endereco     @relation("PedidoEndereco", fields: [enderecoId], references: [id])
  pizzas         Pizza[]      @relation("PedidoPizzas")
  status         StatusPedido // Alterado de String para o Enum
  entregador     Entregador?  @relation(fields: [entregadorId], references: [id])
  entregadorId   Int?
  latitude       Float?
  longitude      Float?
  total          Float?       // Total do pedido em reais
  paymentIntentId String?     // ID do Payment Intent do Stripe
  observacoes    String?      // Observações do pedido
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt
}

model Entregador {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String?
  pedidos   Pedido[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Endereco {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  cep         String
  tipo        String
  logradouro  String
  numero      String
  bairro      String
  complemento String?
  cidade      String
  estado      String
  pais        String?
  referencia  String?
  principal   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pedidos     Pedido[] @relation("PedidoEndereco")
}